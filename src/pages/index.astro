---
import Base         from '../layouts/Base.astro';
import Navbar       from '../components/Navbar.astro';
import Hero         from '../components/Hero.astro';
import Presentation from '../components/Presentation.astro';
import Cabinet      from '../components/Cabinet.astro';
import Pratiques    from '../components/Pratiques.astro';
import Tarifs       from '../components/Tarifs.astro';
import Contact      from '../components/Contact.astro';
import Footer       from '../components/Footer.astro';
---
<Base
  title="Millet Léa | Psychologue Clinicienne D.E à Miramas — Autisme & Neurodéveloppement"
  description="Millet Léa, psychologue clinicienne D.E à Miramas, spécialisée dans l'autisme et les troubles du neurodéveloppement chez l'enfant. Suivi, bilans neuropsychologiques et guidance parentale pour enfants et adolescents."
>
  <Navbar isHome={true} />
  <Hero />
  <Presentation />
  <Cabinet />
  <Pratiques />
  <Tarifs />
  <Contact />
  <Footer isHome={true} />
</Base>
