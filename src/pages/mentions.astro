---
import Base   from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    color: '#93ab82',
    title: 'Créateur du site',
    body: 'Le site web <strong>milletlea-psychologue.com</strong> est créé et maintenu par Mr&nbsp;Chamanier Enzo.',
  },
  {
    color: '#a9c69c',
    title: 'Hébergement',
    body: "Le site est hébergé par la société <strong>OVH</strong>, dont le siège social est situé 2&nbsp;rue Kellermann – 59100 Roubaix – France.",
  },
  {
    color: '#e087a0',
    title: 'Rédaction du site',
    body: "Directrice de la publication&nbsp;: Léa Millet<br />Nom de la responsable&nbsp;: Léa Millet",
  },
  {
    color: '#93ab82',
    title: 'Données personnelles',
    body: "D'une manière générale, vous pouvez visiter le site sans avoir à décliner votre identité et à fournir des informations personnelles vous concernant.",
  },
  {
    color: '#a9c69c',
    title: 'Cookies',
    body: "Le site peut collecter automatiquement des informations standard telles que tous types d'informations personnalisées qui permettent au site d'identifier ses visiteurs.<br /><br />Toutes les informations collectées indirectement ne seront utilisées que pour suivre le volume, le type et la configuration du trafic utilisant ce site, pour en développer la conception et l'agencement et à d'autres fins administratives et de planification, et plus généralement pour améliorer le service que nous vous offrons.",
  },
];
---
<Base
  title="Millet Léa | Mentions légales"
  description="Mentions légales du site de Millet Léa, psychologue clinicienne D.E à Miramas."
  canonical="https://milletlea-psychologue.com/mentions"
  noindex={true}
>
  <Navbar isHome={false} />

  <main class="ml-page">
    <div class="ml-blob ml-blob-a" aria-hidden="true"></div>
    <div class="ml-blob ml-blob-b" aria-hidden="true"></div>

    <div class="ml-wrap">
      <header class="ml-header">
        <h1 class="ml-title">Mentions légales</h1>
        <div class="ml-title-rule"></div>
        <p class="ml-intro">
          Conformément aux dispositions des articles 6-III et 19 de la Loi n°&nbsp;2004-575
          du 21&nbsp;juin 2004 pour la Confiance dans l'économie numérique, dite L.C.E.N.,
          nous portons à la connaissance des utilisateurs et visiteurs du site les
          informations suivantes&nbsp;:
        </p>
      </header>

      <div class="ml-grid">
        {sections.map(s => (
          <article class="ml-card" style={`--accent:${s.color};`}>
            <h2 class="ml-card-title">{s.title}</h2>
            <p set:html={s.body}></p>
          </article>
        ))}
      </div>

      <div class="ml-back">
        <a href="/" class="ml-back-btn">Retour à l'accueil</a>
      </div>
    </div>
  </main>

  <Footer isHome={false} />
</Base>

<style>
  .ml-page {
    position: relative;
    flex: 1 0 auto;
    overflow: hidden;
    padding: calc(62px + 3.5rem) 1.25rem 5rem;
    background:
      radial-gradient(120% 60% at 50% 0%, rgba(147,171,130,0.2), transparent 60%),
      linear-gradient(170deg, #d7e6cc 0%, #c6dbba 100%);
  }

  .ml-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(12px);
  }
  .ml-blob-a {
    width: 420px; height: 420px;
    top: -120px; right: -100px;
    background: radial-gradient(circle, rgba(240,163,184,0.18) 0%, transparent 70%);
  }
  .ml-blob-b {
    width: 380px; height: 380px;
    bottom: -120px; left: -120px;
    background: radial-gradient(circle, rgba(147,171,130,0.22) 0%, transparent 70%);
  }

  .ml-wrap { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; }

  .ml-header { text-align: center; margin-bottom: 3rem; }
  .ml-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 6vw, 2.9rem);
    letter-spacing: 0.02em;
    color: #24422a;
    line-height: 1.1;
  }
  .ml-title-rule {
    width: 64px; height: 4px;
    margin: 1.1rem auto 1.6rem;
    border-radius: 2px;
    background: linear-gradient(90deg, #93ab82, #e087a0);
  }
  .ml-intro {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.85;
    color: #4a5641;
    max-width: 620px;
    margin: 0 auto;
  }

  .ml-grid { display: flex; flex-direction: column; gap: 1.1rem; }
  .ml-card {
    position: relative;
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.85);
    border-radius: 20px;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 10px 30px rgba(60,80,55,0.1);
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease;
  }
  .ml-card::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 110px; height: 110px;
    background: radial-gradient(circle at top right, var(--accent, #93ab82) 0%, transparent 70%);
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .ml-card:hover::before { opacity: 0.85; transform: scale(1.15); }
  .ml-card:hover { transform: translateY(-3px); box-shadow: 0 22px 44px rgba(60,80,55,0.16); }

  .ml-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: #24422a;
    margin: 0 0 0.5rem;
    position: relative; z-index: 1;
  }
  .ml-card p {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.75;
    color: #55635a;
    margin: 0;
    position: relative; z-index: 1;
  }
  .ml-card strong { color: #33402b; }

  .ml-back { text-align: center; margin-top: 2.75rem; }
  .ml-back-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(135deg, #a9c69c, #93ab82);
    padding: 0.8rem 1.9rem;
    border-radius: 999px;
    box-shadow: 0 8px 22px rgba(127,154,111,0.32);
    transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease;
  }
  .ml-back-btn:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 14px 32px rgba(127,154,111,0.45); }

  @media (max-width: 560px) { .ml-card { padding: 1.3rem 1.25rem; } }
</style>
