---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Léa Millet" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"} />

    <!-- Géolocalisation -->
    <meta name="geo.region" content="FR-13" />
    <meta name="geo.placename" content="Miramas" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/pictures/logo.png" />
    <link rel="apple-touch-icon" href="/pictures/logo.png" />

    <!-- Sitemap hint -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts — identité : Fraunces (display) + Caveat (manuscrit) + Hanken Grotesk (texte) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Caveat:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div id="grain" aria-hidden="true"></div>
    <div id="scroll-progress"></div>

    <!-- Fil conducteur : se dessine et descend la page au fil du scroll -->
    <div id="spine" aria-hidden="true">
      <div id="spine-track"></div>
      <div id="spine-fill"></div>
      <div id="spine-mascot"><span class="mascot">🧠</span></div>
    </div>

    <slot />

    <script>
      const reduce  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isTouch = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      const root    = document.documentElement;

      const bar  = document.getElementById('scroll-progress');
      const nav  = document.getElementById('nav');
      const fill = document.getElementById('spine-fill');
      const rider = document.getElementById('spine-mascot');

      /* ── Préparer les traits dessinés (draw-on) ── */
      const scribbles = Array.from(document.querySelectorAll<SVGSVGElement>('.scribble'));
      const scribblePaths = new Map<SVGSVGElement, { path: SVGPathElement; len: number }[]>();
      scribbles.forEach((svg) => {
        const paths = Array.from(svg.querySelectorAll('path')).map((p) => {
          const len = p.getTotalLength();
          p.style.strokeDasharray = String(len);
          if (!reduce) p.style.strokeDashoffset = String(len);
          return { path: p, len };
        });
        scribblePaths.set(svg, paths);
      });

      if (reduce) {
        /* Accessibilité : pas d'animation, tout est visible d'emblée. */
        if (fill) fill.style.height = '100%';
      } else {
        root.classList.add('anim');

        /* Stagger : phase par enfant pour un effet de construction en cascade */
        document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((c) => {
          Array.from(c.children).forEach((child, i) => {
            (child as HTMLElement).classList.add('reveal');
            (child as HTMLElement).dataset.phase = String(i);
          });
        });

        const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
        const pEls    = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

        const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
        const clamp   = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

        let ticking = false;
        function frame() {
          ticking = false;
          const vh = window.innerHeight;
          const st = window.scrollY;
          const max = root.scrollHeight - vh;
          const gp = max > 0 ? clamp(st / max, 0, 1) : 0;

          if (bar) bar.style.width = `${(gp * 100).toFixed(2)}%`;
          if (nav) nav.classList.toggle('scrolled', st > 8);

          /* Fil conducteur : se remplit + la mascotte descend */
          if (fill) fill.style.height = `${(gp * 100).toFixed(2)}%`;
          if (rider) {
            const spineEl = document.getElementById('spine');
            const h = spineEl ? spineEl.clientHeight : root.scrollHeight;
            rider.style.transform = `translateY(${(gp * h).toFixed(1)}px)`;
          }

          /* Construction au scroll : chaque .reveal est piloté par sa position */
          const enter = vh * 0.94;
          const settle = vh * 0.56;
          const range = enter - settle;
          for (const el of reveals) {
            const r = el.getBoundingClientRect();
            const phase = (parseInt(el.dataset.phase || '0', 10)) * 46;
            const p = easeOut(clamp((enter - (r.top + phase)) / range, 0, 1));
            const inv = 1 - p;
            let tf: string;
            if (el.classList.contains('reveal-left'))       tf = `translateX(${(-52 * inv).toFixed(1)}px)`;
            else if (el.classList.contains('reveal-right')) tf = `translateX(${(52 * inv).toFixed(1)}px)`;
            else if (el.classList.contains('reveal-scale')) tf = `translateY(${(28 * inv).toFixed(1)}px) scale(${(1 - 0.1 * inv).toFixed(3)})`;
            else if (el.classList.contains('reveal-zoom'))  tf = `scale(${(1 - 0.14 * inv).toFixed(3)})`;
            else                                            tf = `translateY(${(38 * inv).toFixed(1)}px)`;
            el.style.opacity = p.toFixed(3);
            el.style.transform = tf;
          }

          /* Parallaxe */
          if (!isTouch) {
            const mid = vh / 2;
            for (const el of pEls) {
              const r = el.getBoundingClientRect();
              const off = (r.top + r.height / 2) - mid;
              const f = parseFloat(el.dataset.parallax || '0.1') || 0.1;
              el.style.translate = `0 ${(-off * f).toFixed(1)}px`;
            }
          }

          /* Traits qui se dessinent selon le scroll */
          for (const svg of scribbles) {
            const r = svg.getBoundingClientRect();
            const p = easeOut(clamp((vh * 0.9 - r.top) / (vh * 0.4), 0, 1));
            const paths = scribblePaths.get(svg);
            if (paths) for (const { path, len } of paths) path.style.strokeDashoffset = `${(len * (1 - p)).toFixed(1)}`;
          }
        }

        function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.addEventListener('load', onScroll, { passive: true });
        frame();
      }
    </script>
  </body>
</html>
