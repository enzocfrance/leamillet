---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Millet Léa — Psychologue Clinicienne D.E à Miramas | Autisme & Neurodéveloppement",
  description = "Millet Léa, psychologue clinicienne D.E à Miramas, spécialisée dans l'autisme et les troubles du neurodéveloppement chez l'enfant. Suivi, bilans neuropsychologiques, guidance parentale pour enfants et adolescents.",
  keywords = "Millet Léa, psychologue Miramas, psychologue enfant, autisme, TSA, troubles du neurodéveloppement, bilan neuropsychologique, WISC, ADI-R, guidance parentale, ESDM, ABA, TEACCH, Denver",
  canonical = "https://milletlea-psychologue.com/",
  ogImage = "https://milletlea-psychologue.com/pictures/logo.png",
  noindex = false,
} = Astro.props;

const siteName = "Millet Léa — Psychologue clinicienne à Miramas";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalBusiness", "LocalBusiness"],
      "@id": "https://milletlea-psychologue.com/#cabinet",
      "name": "Millet Léa — Psychologue clinicienne D.E",
      "description": "Cabinet de psychologie à Miramas spécialisé dans l'autisme et les troubles du neurodéveloppement chez l'enfant : suivi, bilans neuropsychologiques, guidance parentale.",
      "url": "https://milletlea-psychologue.com/",
      "telephone": "+33616037537",
      "email": "lea.millet.psy13@gmail.com",
      "priceRange": "35€ – 430€",
      "currenciesAccepted": "EUR",
      "paymentAccepted": "Espèces, Chèque",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "34 avenue du Maréchal Juin",
        "addressLocality": "Miramas",
        "postalCode": "13140",
        "addressRegion": "Provence-Alpes-Côte d'Azur",
        "addressCountry": "FR"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Wednesday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "areaServed": [
        { "@type": "City", "name": "Miramas" },
        { "@type": "City", "name": "Saint-Chamas" },
        { "@type": "City", "name": "Salon-de-Provence" },
        { "@type": "City", "name": "Istres" }
      ],
      "medicalSpecialty": "MentalHealth",
      "employee": { "@id": "https://milletlea-psychologue.com/#lea" }
    },
    {
      "@type": "Person",
      "@id": "https://milletlea-psychologue.com/#lea",
      "name": "Léa Millet",
      "jobTitle": "Psychologue clinicienne D.E",
      "honorificPrefix": "Mme",
      "url": "https://milletlea-psychologue.com/",
      "telephone": "+33616037537",
      "email": "lea.millet.psy13@gmail.com",
      "worksFor": { "@id": "https://milletlea-psychologue.com/#cabinet" }
    },
    {
      "@type": "WebSite",
      "@id": "https://milletlea-psychologue.com/#website",
      "url": "https://milletlea-psychologue.com/",
      "name": siteName,
      "inLanguage": "fr-FR",
      "publisher": { "@id": "https://milletlea-psychologue.com/#lea" }
    },
    {
      "@type": "WebPage",
      "@id": "https://milletlea-psychologue.com/#webpage",
      "url": canonical,
      "name": title,
      "isPartOf": { "@id": "https://milletlea-psychologue.com/#website" },
      "about": { "@id": "https://milletlea-psychologue.com/#cabinet" },
      "inLanguage": "fr-FR"
    }
  ]
};
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO de base -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Léa Millet" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large"} />

    <!-- Géolocalisation -->
    <meta name="geo.region" content="FR-13" />
    <meta name="geo.placename" content="Miramas" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/pictures/logo.png" />
    <link rel="apple-touch-icon" href="/pictures/logo.png" />

    <!-- Sitemap hint -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <script>
      /* Scroll reveal — fondu montant discret */
      const io = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('show');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
    </script>
  </body>
</html>
