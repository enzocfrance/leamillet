---
import Mascot from './Mascot.astro';
import SectionHeading from './SectionHeading.astro';
import Divider from './Divider.astro';

const difficultes = [
  'Attentionnelles', 'Impulsivité', 'Organisation, inhibition, flexibilité, planification',
  'Estime de soi', 'Régulation émotionnelle', 'Relation sociale', 'Communication',
];
const suivi = [
  "Premier entretien d'anamnèse avec les parents",
  'Mise en place du suivi avec évaluation des besoins',
  'Définition des objectifs',
  'Accompagnement personnalisé',
];
const bilan = [
  "L'anamnèse en présence du parent",
  "Séances d'évaluation (entre 2 et 5)",
  'Rédaction des résultats',
  "Restitution lors d'un rendez-vous",
];
---
<section id="pratique" class="section pratique">
  <span class="blob prat-blob-1" aria-hidden="true"></span>
  <span class="blob prat-blob-2" aria-hidden="true"></span>

  <div class="section-inner">
    <SectionHeading eyebrow="Le suivi" light>
      Un accompagnement <span class="mark">sur mesure</span>
      <Fragment slot="lead">
        Chaque suivi est adapté à l'enfant, à son âge et à ses besoins — de l'évaluation à un
        accompagnement personnalisé.
      </Fragment>
    </SectionHeading>

    <!-- Difficultés -->
    <div class="prat-diff card reveal">
      <div class="prat-diff-head">
        <div class="prat-diff-mascot"><Mascot size={62} /></div>
        <h3 class="prat-diff-title">J'accompagne les enfants et adolescents dans leurs difficultés&nbsp;:</h3>
      </div>
      <ul class="prat-chips" data-stagger="60">
        {difficultes.map(d => <li class="prat-chip">{d}</li>)}
      </ul>
    </div>

    <!-- Timelines -->
    <div class="prat-cols">
      <article class="prat-col card reveal reveal-left">
        <span class="badge prat-badge">Consultations</span>
        <h3 class="prat-col-title">Le déroulement du suivi</h3>
        <ol class="timeline">
          {suivi.map((s, i) => (
            <li class="tl-item">
              <span class="tl-node">{i + 1}</span>
              <div class="tl-body"><h4>{s}</h4></div>
            </li>
          ))}
        </ol>
      </article>

      <article class="prat-col card reveal reveal-right">
        <span class="badge prat-badge prat-badge--pink">Bilans</span>
        <h3 class="prat-col-title">Pour les bilans neuropsychologiques</h3>
        <ol class="timeline">
          {bilan.map((b, i) => (
            <li class="tl-item">
              <span class="tl-node tl-node--pink">{i + 1}</span>
              <div class="tl-body"><h4>{b}</h4></div>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </div>

  <Divider color="#93ab82" variant={1} />
</section>

<style>
  .pratique {
    background: linear-gradient(180deg, #a9c69c 0%, #9dbd8f 100%);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }
  .prat-blob-1 { width: 380px; height: 380px; top: 6%; right: -8%; background: radial-gradient(circle, rgba(255,255,255,0.45), transparent 70%); }
  .prat-blob-2 { width: 340px; height: 340px; bottom: 4%; left: -7%; background: radial-gradient(circle, rgba(240,163,184,0.25), transparent 70%); }

  /* Difficultés */
  .prat-diff { padding: clamp(1.5rem, 3vw, 2.2rem); max-width: 860px; margin: 0 auto 1.8rem; }
  .prat-diff-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.3rem; }
  .prat-diff-mascot { line-height: 0; flex-shrink: 0; }
  .prat-diff-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(0.98rem, 2.2vw, 1.15rem); line-height: 1.4; color: #2f4a2c;
  }
  .prat-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .prat-chip {
    font-family: var(--font-body); font-size: 0.83rem; color: #33402b;
    background: linear-gradient(135deg, rgba(168,200,147,0.22), rgba(168,200,147,0.1));
    border: 1px solid rgba(147, 171, 130, 0.35);
    border-radius: 999px; padding: 0.5rem 1rem;
    transition: transform 0.3s var(--spring), background 0.3s ease, box-shadow 0.3s ease;
  }
  .prat-chip:hover {
    transform: translateY(-2px);
    background: #fff;
    box-shadow: 0 8px 18px -10px rgba(47, 74, 44, 0.4);
  }

  /* Timelines */
  .prat-cols { display: grid; grid-template-columns: 1fr; gap: 1.5rem; max-width: 860px; margin: 0 auto; }
  @media (min-width: 760px) { .prat-cols { grid-template-columns: 1fr 1fr; } }

  .prat-col { padding: clamp(1.6rem, 3vw, 2.1rem); }
  .prat-badge {
    background: rgba(147, 171, 130, 0.18);
    color: #4a5c41;
    margin-bottom: 0.9rem;
  }
  .prat-badge--pink { background: rgba(240, 163, 184, 0.22); color: #c06783; }
  .prat-col-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: 1.05rem; line-height: 1.3; color: #2b342d; margin-bottom: 1.3rem;
  }
</style>
