---
import Mascot from './Mascot.astro';
import Scribble from './Scribble.astro';

const difficultes = [
  'Attentionnelles',
  'Impulsivité',
  'Organisation, inhibition, flexibilité, planification',
  'Estime de soi',
  'Régulation émotionnelle',
  'Relation sociale',
  'Communication',
];

const suivi = [
  "Premier entretien d'anamnèse avec les parents",
  'Mise en place du suivi avec évaluation des besoins',
  'Mise en place des objectifs',
  'Accompagnement personnalisé',
];

const bilan = [
  "L'anamnèse en présence du parent",
  "Séances d'évaluation entre 2 et 5",
  'Rédaction des résultats',
  "Restitution lors d'un rendez-vous",
];
---
<section id="pratique" class="section pratique">
  <div class="prat-scribble prat-scribble-1"><Scribble variant="sparkle" width={50} /></div>

  <div class="section-inner">

    <!-- Difficultés -->
    <div class="prat-diff reveal">
      <div class="prat-diff-head">
        <div class="prat-diff-mascot"><Mascot size={70} /></div>
        <p class="prat-diff-lead">
          Lors de mes suivis, j'accompagne les enfants et adolescents dans leurs
          difficultés&nbsp;:
        </p>
      </div>
      <ul class="prat-chips">
        {difficultes.map(d => <li class="prat-chip">{d}</li>)}
      </ul>
    </div>

    <!-- Déroulés -->
    <div class="prat-cols">

      <article class="prat-col reveal">
        <div class="prat-col-head">
          <div class="prat-col-mascot"><Mascot size={58} float={false} /></div>
          <h3 class="prat-col-title">Le déroulement du suivi<br/>et des consultations</h3>
        </div>
        <ol class="prat-steps">
          {suivi.map(s => <li>{s}</li>)}
        </ol>
      </article>

      <article class="prat-col reveal reveal-delay-1">
        <div class="prat-col-head">
          <div class="prat-col-mascot"><Mascot size={58} float={false} /></div>
          <h3 class="prat-col-title">Pour les bilans<br/>neuropsychologiques</h3>
        </div>
        <ol class="prat-steps">
          {bilan.map(b => <li>{b}</li>)}
        </ol>
      </article>

    </div>
  </div>
</section>

<style>
  .pratique { background: #a9c69c; color: #2f3a2c; }

  /* Difficultés */
  .prat-diff { max-width: 760px; margin: 0 auto 3rem; }
  .prat-diff-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
  }
  .prat-diff-lead {
    font-family: 'Quicksand', sans-serif;
    font-weight: 600;
    font-size: clamp(1rem, 2.3vw, 1.2rem);
    color: #24422a;
    max-width: 440px;
    text-align: center;
  }
  .prat-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .prat-chip {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    color: #2f3a2c;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    box-shadow: 0 4px 12px rgba(60, 80, 55, 0.08);
    transition: transform 0.3s var(--spring), background 0.3s ease;
  }
  .prat-chip:hover { transform: translateY(-2px); background: #fff; }

  /* Colonnes de déroulé */
  .prat-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 860px;
    margin: 0 auto;
  }
  @media (min-width: 760px) {
    .prat-cols { grid-template-columns: 1fr 1fr; }
  }

  .prat-col {
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 22px;
    padding: 1.75rem 1.6rem;
    box-shadow: 0 12px 30px rgba(60, 80, 55, 0.1);
  }
  .prat-col-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .prat-col-title {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.3;
    color: #24422a;
  }

  .prat-steps {
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .prat-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 2.4rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.9rem;
    line-height: 1.55;
    color: #37423a;
  }
  .prat-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0; top: -2px;
    width: 1.7rem; height: 1.7rem;
    display: flex; align-items: center; justify-content: center;
    background: #93ab82;
    color: #fff;
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: 0.82rem;
    border-radius: 50%;
    box-shadow: 0 4px 10px rgba(127, 154, 111, 0.4);
  }

  /* accents */
  .prat-scribble { position: absolute; top: 8%; right: 9%; transform: rotate(-8deg); opacity: 0.85; }

  @media (max-width: 760px) {
    .prat-col-mascot, .prat-diff-mascot { display: none; }
  }
</style>
