---
const models = ['ABA', 'TEACCH', 'DENVER', 'ESDM', 'TCC'];

const domaines = [
  {
    n: '01',
    icon: '🌱',
    color: '#016d77',
    colorLight: 'rgba(1,109,119,0.08)',
    title: 'Intervention précoce (ESDM)',
    body: `Je mets en place des programmes d'intervention précoce <strong>ESDM</strong> et j'accompagne les familles et les enfants <strong>dès 18 mois</strong> pour toute suspicion de retard de développement.`,
  },
  {
    n: '02',
    icon: '🧩',
    color: '#5fa89f',
    colorLight: 'rgba(95,168,159,0.10)',
    title: 'Séances individuelles',
    body: `Des séances individuelles de <strong>45 minutes</strong>, de l'enfance jusqu'à <strong>16 ans</strong>, orientées selon les modèles développementaux, cognitifs et comportementaux, en remédiation cognitive et gestion des émotions.`,
  },
  {
    n: '03',
    icon: '👨‍👩‍👧',
    color: '#a8c893',
    colorLight: 'rgba(168,200,147,0.14)',
    title: 'Guidance parentale',
    body: `Des séances d'<strong>une heure</strong> destinées à la guidance parentale, afin d'accompagner les parents dans la compréhension des troubles de leur enfant et dans les adaptations à mettre en place à domicile.`,
  },
  {
    n: '04',
    icon: '🤝',
    color: '#0f8b8d',
    colorLight: 'rgba(15,139,141,0.10)',
    title: "Groupes d'habiletés sociales",
    body: `En fonction des demandes et des profils d'enfants, je peux mettre en place des <strong>groupes d'habiletés sociales</strong> sur la base des programmes <strong>GECO's</strong> et <strong>GASC</strong>.`,
  },
];

const prises = [
  'Repérage précoce d\'un retard de développement',
  'Troubles du spectre de l\'autisme',
  'Haut potentiel intellectuel',
  'Troubles de l\'attention (avec ou sans hyperactivité)',
  'Troubles des apprentissages',
  'Troubles anxieux',
  'Difficultés de régulation émotionnelle',
  'Phobie scolaire',
  'Phobie sociale',
];

const bilans = [
  {
    title: 'Niveau de développement',
    body: `Grilles <strong>ESDM</strong>, questionnaire de la <strong>Vineland</strong> et bilan standardisé <strong>PEP-3</strong>.`,
    note: `Comptez un entretien d'anamnèse, 1 h de questionnaire, 2 séances d'1 h pour la passation du PEP-3 et un entretien de restitution d'1 h.`,
  },
  {
    title: 'Particularités du fonctionnement autistique',
    body: `Questionnaires <strong>CARS-T</strong> et <strong>Profil de Dunn 2</strong>, avec <strong>PEP-3</strong> chez l'enfant de moins de 8 ans.`,
    note: `Comptez un entretien d'anamnèse, 1 h par questionnaire, 2 séances d'1 h pour la passation du PEP-3 et un entretien de restitution d'1 h.`,
  },
  {
    title: 'Bilan cognitif / neuropsychologique',
    body: `Évaluations standardisées <strong>WISC-V</strong>, <strong>WPPSI-IV</strong>, questionnaires <strong>BRIEF</strong>, échelles <strong>Conners</strong> et échelle de <strong>Brown</strong> selon le profil.`,
    note: `Comptez un entretien d'anamnèse, 1 h de questionnaires, 2 séances d'1 h pour la passation du WISC ou de la Vineland, puis un entretien de restitution d'1 h.`,
  },
  {
    title: "Évaluation de l'anxiété",
    body: `Questionnaire <strong>R-CMAS</strong>.`,
    note: `Comptez un entretien d'anamnèse, 1 h de questionnaire et une restitution de 45 min si c'est le seul bilan réalisé.`,
  },
];
---

<section id="pratique" class="relative" style="background: linear-gradient(170deg, #eef8e6 0%, #f4fef2 55%, #e7f5df 100%);">
  <div class="prat-wrap">

    <!-- ── HEADER ── -->
    <header class="prat-header slide-up">
      <p class="prat-eyebrow">03 · Ma pratique</p>
      <h2 class="prat-big-title">Ce que<br/>je propose</h2>
      <p class="prat-intro">
        Ma pratique est sous-tendue par les <strong>approches développementales, cognitives et
        comportementales</strong>. J'oriente mes séances selon les modèles suivants, en remédiation
        cognitive et gestion des émotions&nbsp;:
      </p>
      <div class="prat-models">
        {models.map(m => <span class="prat-model-chip">{m}</span>)}
      </div>
    </header>

    <!-- ── DOMAINES D'INTERVENTION ── -->
    <div class="prat-list">
      {domaines.map((item, i) => (
        <article class="prat-item slide-up" style={`--c:${item.color}; --cl:${item.colorLight}; animation-delay:${i * 80}ms`}>
          <div class="prat-accent" aria-hidden="true">
            <span class="prat-num">{item.n}</span>
            <div class="prat-icon-wrap" style={`background:${item.colorLight}; border-color:${item.color}33;`}>
              <span class="prat-emoji">{item.icon}</span>
            </div>
          </div>
          <div class="prat-body">
            <h3 class="prat-title" style={`color:${item.color}`}>{item.title}</h3>
            <p class="prat-text" set:html={item.body}></p>
          </div>
        </article>
      ))}
    </div>

    <!-- ── PRISES EN CHARGE ── -->
    <div class="prat-charge slide-up">
      <h3 class="prat-sub-title">Mes prises en charge</h3>
      <p class="prat-sub-lead">
        De l'enfance jusqu'à 16 ans, mes accompagnements s'orientent notamment vers&nbsp;:
      </p>
      <div class="prat-tags">
        {prises.map(p => <span class="prat-tag">{p}</span>)}
      </div>
    </div>

    <!-- ── BILANS ── -->
    <div class="prat-bilans slide-up">
      <h3 class="prat-sub-title">Les bilans que je réalise</h3>
      <div class="prat-bilan-grid">
        {bilans.map(b => (
          <article class="prat-bilan-card">
            <h4 class="prat-bilan-title">{b.title}</h4>
            <p class="prat-bilan-body" set:html={b.body}></p>
            <p class="prat-bilan-note" set:html={`<span aria-hidden="true">✳</span> ${b.note}`}></p>
          </article>
        ))}
      </div>
    </div>

    <!-- ── NOTE BAS ── -->
    <p class="prat-note slide-up">
      Une sensibilisation à l'autisme et des déplacements en structure sont possibles sur devis —
      n'hésitez pas à me contacter au préalable.
    </p>

  </div>
</section>

<style is:global>

/* ── Wrapper principal ───────────────────────────────── */
.prat-wrap {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 2.5rem;
  width: 100%;
}

/* ── Header ──────────────────────────────────────────── */
.prat-header {
  padding-top: 5dvh;
  padding-bottom: 3dvh;
  border-bottom: 1px solid rgba(1, 109, 119, 0.14);
}
.prat-eyebrow {
  font-family: 'Candal', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(1, 109, 119, 0.65);
  margin-bottom: 1rem;
}
.prat-big-title {
  font-family: 'Candal', sans-serif;
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  line-height: 1.08;
  color: #22423f;
  margin-bottom: 1.2rem;
}
.prat-intro {
  font-family: 'Lato', sans-serif;
  font-size: 0.95rem;
  line-height: 1.85;
  color: #566766;
  max-width: 620px;
}
.prat-intro strong { color: #016d77; }

.prat-models {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 1.4rem;
}
.prat-model-chip {
  font-family: 'Candal', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: #016d77;
  background: rgba(1, 109, 119, 0.08);
  border: 1px solid rgba(1, 109, 119, 0.22);
  border-radius: 999px;
  padding: 6px 16px;
  transition: transform 0.3s var(--spring), background 0.3s ease, color 0.3s ease;
}
.prat-model-chip:hover {
  transform: translateY(-2px);
  background: #016d77;
  color: #fff;
}

/* ── Liste des domaines ──────────────────────────────── */
.prat-list { display: flex; flex-direction: column; }

.prat-item {
  display: grid;
  grid-template-columns: 88px 1fr;
  gap: 0;
  border-bottom: 1px solid rgba(1, 109, 119, 0.10);
  transition: background 0.3s ease;
}
.prat-item:hover { background: var(--cl); }

.prat-accent {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 2.2rem 0 2rem;
  border-right: 1px solid rgba(1, 109, 119, 0.12);
  gap: 0.7rem;
}
.prat-num {
  font-family: 'Candal', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  color: var(--c);
  opacity: 0.55;
}
.prat-icon-wrap {
  width: 44px; height: 44px;
  border-radius: 12px;
  border: 1px solid;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1);
}
.prat-item:hover .prat-icon-wrap { transform: scale(1.14) rotate(6deg); }
.prat-emoji { font-size: 1.4rem; line-height: 1; }

.prat-body { padding: 2.2rem 2rem 2rem 2rem; }
.prat-title {
  font-family: 'Candal', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.02em;
  margin-bottom: 0.7rem;
  line-height: 1.3;
}
.prat-text {
  font-family: 'Lato', sans-serif;
  font-size: 0.9rem;
  line-height: 1.85;
  color: #566766;
}
.prat-text strong { color: #3a4b4a; font-weight: 700; }

/* ── Prises en charge ────────────────────────────────── */
.prat-charge { padding: 3rem 0 1rem; }
.prat-sub-title {
  font-family: 'Candal', sans-serif;
  font-size: 1.25rem;
  letter-spacing: 0.03em;
  color: #22423f;
  margin-bottom: 0.6rem;
}
.prat-sub-lead {
  font-family: 'Lato', sans-serif;
  font-size: 0.9rem;
  line-height: 1.75;
  color: #566766;
  margin-bottom: 1.4rem;
}
.prat-tags { display: flex; flex-wrap: wrap; gap: 0.6rem; }
.prat-tag {
  font-family: 'Lato', sans-serif;
  font-size: 0.82rem;
  color: #3a4b4a;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(1, 109, 119, 0.15);
  border-radius: 12px;
  padding: 8px 14px;
  box-shadow: 0 4px 12px rgba(1, 74, 82, 0.05);
  transition: transform 0.3s var(--spring), box-shadow 0.3s ease, border-color 0.3s ease;
}
.prat-tag:hover {
  transform: translateY(-3px);
  border-color: #5fa89f;
  box-shadow: 0 10px 22px rgba(1, 74, 82, 0.12);
}

/* ── Bilans ──────────────────────────────────────────── */
.prat-bilans { padding: 3rem 0 1rem; }
.prat-bilan-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.1rem;
  margin-top: 1.4rem;
}
@media (min-width: 720px) {
  .prat-bilan-grid { grid-template-columns: 1fr 1fr; }
}
.prat-bilan-card {
  position: relative;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(1, 109, 119, 0.12);
  border-left: 4px solid #5fa89f;
  border-radius: 0 16px 16px 0;
  padding: 1.4rem 1.5rem;
  box-shadow: 0 8px 24px rgba(1, 74, 82, 0.06);
  transition: transform 0.35s var(--spring), box-shadow 0.35s ease, border-left-color 0.35s ease;
}
.prat-bilan-card:hover {
  transform: translateY(-3px);
  border-left-color: #016d77;
  box-shadow: 0 16px 34px rgba(1, 74, 82, 0.13);
}
.prat-bilan-title {
  font-family: 'Candal', sans-serif;
  font-size: 0.95rem;
  color: #016d77;
  margin-bottom: 0.55rem;
  line-height: 1.3;
}
.prat-bilan-body {
  font-family: 'Lato', sans-serif;
  font-size: 0.86rem;
  line-height: 1.7;
  color: #566766;
  margin-bottom: 0.7rem;
}
.prat-bilan-body strong { color: #3a4b4a; }
.prat-bilan-note {
  font-family: 'Lato', sans-serif;
  font-size: 0.76rem;
  font-style: italic;
  line-height: 1.6;
  color: #7a8b8a;
  border-top: 1px dashed rgba(1, 109, 119, 0.15);
  padding-top: 0.6rem;
}
.prat-bilan-note span { color: #a8c893; font-style: normal; margin-right: 3px; }

/* ── Note de bas de page ─────────────────────────────── */
.prat-note {
  padding: 2rem 0 3rem;
  font-family: 'Lato', sans-serif;
  font-size: 0.82rem;
  font-style: italic;
  color: rgba(95, 168, 159, 0.95);
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}

/* ── Mobile responsive ──────────────────────────────── */
@media (max-width: 639px) {
  .prat-wrap { padding: 0 1rem; }
  .prat-item { grid-template-columns: 56px 1fr; }
  .prat-accent { padding: 1.6rem 0 1.4rem; gap: 0.5rem; }
  .prat-icon-wrap { width: 36px; height: 36px; border-radius: 8px; }
  .prat-emoji { font-size: 1.1rem; }
  .prat-body { padding: 1.6rem 1rem 1.4rem 1rem; }
  .prat-big-title { font-size: clamp(1.8rem, 9vw, 2.4rem); }
  .prat-intro { font-size: 0.88rem; line-height: 1.75; }
  .prat-text { font-size: 0.84rem; line-height: 1.8; }
  .prat-header { padding-top: 3dvh; padding-bottom: 2.5dvh; }
  .prat-note { padding: 1.5rem 0 2.5rem; }
}

</style>
