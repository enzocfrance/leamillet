---
const gallery = [
  { src: '/pictures/left.png',   alt: 'Cabinet — espace de médiations thérapeutiques' },
  { src: '/pictures/center.png', alt: 'Cabinet — salle de consultation' },
  { src: '/pictures/right.png',  alt: 'Cabinet — coin dédié aux enfants' },
];
---
<section id="lieux" class="relative pb-32 pt-20" style="background: linear-gradient(180deg, #f7fce9 0%, #eef8e6 100%);">
  <div class="mx-auto max-w-5xl px-5 sm:px-10 md:px-16">

    <h2 class="scroll-zoom section-heading">LE CABINET</h2>

    <p class="slide-up lieux-intro">
      Je reçois les enfants et leurs parents au <strong>cabinet pluridisciplinaire de la Cabane</strong>,
      dans un espace dédié aux médiations thérapeutiques préparées en amont.
    </p>

    <!-- ── Galerie ── -->
    <div class="lieux-gallery stagger">
      {gallery.map(g => (
        <figure class="lieux-card slide-up">
          <img src={g.src} alt={g.alt} loading="lazy" />
          <span class="lieux-card-glow" aria-hidden="true"></span>
        </figure>
      ))}
    </div>

    <!-- ── Localisation + carte ── -->
    <div class="lieux-grid">

      <div class="slide-up lieux-info">
        <div class="lieux-info-icon" aria-hidden="true">📍</div>
        <h3 class="lieux-info-title">Où me trouver&nbsp;?</h3>
        <p class="lieux-info-body">
          Cabinet pluridisciplinaire de la Cabane<br />
          <strong>Miramas (13140)</strong>
        </p>
        <div class="lieux-hours">
          <span aria-hidden="true">🕘</span>
          Ouverture le <strong>mercredi</strong>, de 9&nbsp;h à 18&nbsp;h
        </div>
        <a
          href="https://www.doctolib.fr/psychologue/miramas/lea-millet/booking"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary lieux-doctolib"
          style="background:#016d77; color:#fff; box-shadow: 0 6px 24px rgba(1,109,119,0.3);"
        >
          <span class="text-sm font-semibold tracking-wide">Prendre RDV sur</span>
          <img src="https://pro.doctolib.fr/external_button/doctolib-white-transparent.png" alt="Doctolib" style="height:18px;width:auto;display:inline-block;margin-left:8px;vertical-align:middle;" loading="lazy" />
        </a>
      </div>

      <div class="slide-up lieux-map-outer">
        <div class="lieux-map-wrapper">
          <iframe
            class="lieux-map-iframe"
            src="https://maps.google.com/maps?q=Miramas%2013140&z=13&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localisation du cabinet à Miramas"
          ></iframe>
        </div>
      </div>

    </div>
  </div>

  <!-- Wave → contact (#016d77) -->
  <div class="wave-seal pointer-events-none absolute bottom-0 left-0 w-full" style="line-height:0; margin-bottom:-1px;" aria-hidden="true">
    <svg viewBox="0 0 1440 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width:100%; height:70px; display:block;">
      <path fill="rgba(1,109,119,0.4)" d="M0,35 C480,0 960,70 1440,35 L1440,70 L0,70 Z"/>
      <path fill="#016d77" d="M0,45 C420,10 1020,65 1440,45 L1440,70 L0,70 Z"/>
    </svg>
  </div>
</section>

<style is:global>
  .lieux-intro {
    max-width: 640px;
    margin: 0 auto 2.6rem;
    text-align: center;
    font-family: 'Candal', sans-serif;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    line-height: 1.7;
    color: #3a4b4a;
    letter-spacing: 0.01em;
  }
  .lieux-intro strong { color: #016d77; }

  /* ── Galerie ── */
  .lieux-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 720px) {
    .lieux-gallery { grid-template-columns: repeat(3, 1fr); }
  }

  .lieux-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    padding: 4px;
    box-shadow: 0 12px 34px rgba(1, 74, 82, 0.12);
    will-change: transform;
  }
  .lieux-card img {
    display: block;
    width: 100%;
    height: 230px;
    object-fit: cover;
    border-radius: 16px;
  }
  .lieux-card-glow {
    position: absolute;
    inset: 4px;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(1,109,119,0) 55%, rgba(1,109,119,0.28) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .lieux-card:hover .lieux-card-glow { opacity: 1; }

  /* ── Localisation + carte ── */
  .lieux-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: stretch;
  }
  @media (min-width: 860px) {
    .lieux-grid { grid-template-columns: 0.85fr 1.15fr; }
  }

  .lieux-info {
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(1, 109, 119, 0.12);
    border-radius: 22px;
    padding: 2rem 1.9rem;
    box-shadow: 0 14px 38px rgba(1, 74, 82, 0.1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .lieux-info-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    background: rgba(1, 109, 119, 0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 1rem;
  }
  .lieux-info-title {
    font-family: 'Candal', sans-serif;
    font-size: 1.1rem;
    color: #22423f;
    margin-bottom: 0.6rem;
  }
  .lieux-info-body {
    font-family: 'Lato', sans-serif;
    font-size: 0.92rem;
    line-height: 1.7;
    color: #566766;
    margin-bottom: 1.1rem;
  }
  .lieux-info-body strong { color: #016d77; }
  .lieux-hours {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Lato', sans-serif;
    font-size: 0.86rem;
    color: #3a4b4a;
    background: rgba(168, 200, 147, 0.18);
    border-radius: 12px;
    padding: 0.55rem 0.9rem;
    margin-bottom: 1.5rem;
  }
  .lieux-hours strong { color: #016d77; }
  .lieux-doctolib {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }
  .lieux-doctolib:hover {
    background: #014a52 !important;
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(1, 74, 82, 0.45) !important;
  }

  .lieux-map-outer { min-height: 300px; }
  .lieux-map-wrapper {
    position: relative;
    border-radius: 20px;
    padding: 3px;
    height: 100%;
    background: linear-gradient(135deg, #016d77 0%, #5fa89f 55%, #a8c893 100%);
    box-shadow: 0 12px 48px rgba(1, 74, 82, 0.25);
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }
  .lieux-map-wrapper:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 60px rgba(1, 74, 82, 0.35);
  }
  .lieux-map-iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 300px;
    border: none;
    border-radius: 17px;
  }

  @media (max-width: 639px) {
    .lieux-card img { height: 200px; }
    .lieux-info { padding: 1.6rem 1.4rem; }
  }
</style>
