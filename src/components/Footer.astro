---
interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const topHref = isHome ? '#accueil' : '/';
---
<footer
  class="py-12 text-center"
  style="background: linear-gradient(160deg, #016d77 0%, #014a52 100%);"
>
  <!-- Séparateur décoratif -->
  <div style="width:60px; height:2px; background:linear-gradient(90deg, rgba(167,218,229,0.85), transparent); border-radius:2px; margin:0 auto 1.5rem;"></div>

  <!-- Back to top -->
  <a
    href={topHref}
    class="footer-float-btn mb-6 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/25 transition-all duration-300 hover:scale-[1.15] hover:bg-white/45 hover:shadow-lg"
    title="Remonter en haut"
    aria-label="Remonter à l'accueil"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
  </a>

  <!-- Nom + titre -->
  <p style="font-family:'Candal',sans-serif; font-size:1.1rem; letter-spacing:0.1em; color:white; margin-bottom:8px;">
    Léa Millet
  </p>
  <p style="font-family:'Lato',sans-serif; font-size:0.8rem; color:rgba(255,255,255,0.78); font-style:italic; margin-bottom:16px;">
    Psychologue clinicienne D.E — Autisme &amp; neurodéveloppement
  </p>

  <!-- Copyright + mentions légales -->
  <p class="text-xs text-white/60">
    Tous droits réservés &nbsp;·&nbsp;
    <a href="/mentions" class="underline underline-offset-2 transition-colors hover:text-white">
      Mentions légales
    </a>
  </p>

  <!-- Crédit développeur -->
  <p class="mt-3 text-white/30" style="font-size:10px;">
    Site réalisé par
    <a
      href="mailto:enzo.chamanier.pro@gmail.com"
      style="color:inherit; text-decoration:none;"
    >Enzo Chamanier</a>
  </p>
</footer>

<style is:global>
  /* ── Footer float button animation ─────────────────────── */
  .footer-float-btn {
    animation: footer-float 2s ease-in-out infinite;
  }
  .footer-float-btn:hover {
    animation-play-state: paused;
  }
  @keyframes footer-float {
    0%   { transform: translateY(0); }
    50%  { transform: translateY(-5px); }
    100% { transform: translateY(0); }
  }
</style>
