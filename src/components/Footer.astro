---
import Mascot from './Mascot.astro';
interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;
const topHref = isHome ? '#accueil' : '/';
---
<footer class="footer">
  <div class="footer-soon" data-stagger="90">
    <div class="footer-soon-mascot" data-parallax="0.07"><Mascot size={58} /></div>
    <p class="footer-soon-badge">🌿 Prochainement</p>
    <p class="footer-soon-line">Prochainement à <strong>Saint-Chamas</strong></p>
    <p class="footer-soon-line">
      Ouverture de <strong>groupes d'habiletés sociales</strong> à <strong>Salon-de-Provence</strong>
    </p>
  </div>

  <div class="footer-bar">
    <a href={topHref} class="footer-top" aria-label="Remonter en haut" title="Remonter">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15l7-7 7 7"/></svg>
    </a>
    <p class="footer-name">Millet Léa</p>
    <p class="footer-role">Psychologue clinicienne D.E — Autisme &amp; neurodéveloppement</p>
    <p class="footer-legal">
      Tous droits réservés&nbsp;·&nbsp;
      <a href="/mentions">Mentions légales</a>
    </p>
    <p class="footer-credit">
      Site réalisé par
      <a href="mailto:enzo.chamanier.pro@gmail.com">Enzo Chamanier</a>
    </p>
  </div>
</footer>

<style>
  .footer { background: #d7e6cc; }

  .footer-soon {
    text-align: center;
    padding: 3rem 1.25rem 2.4rem;
    border-top: 1px solid rgba(147, 171, 130, 0.3);
  }
  .footer-soon-mascot { display: inline-block; line-height: 0; margin-bottom: 0.9rem; opacity: 0.9; }
  .footer-soon-badge {
    font-family: 'Quicksand', sans-serif;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6f8064;
    margin-bottom: 0.7rem;
  }
  .footer-soon-line {
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    color: #2b342d;
    line-height: 1.6;
  }
  .footer-soon-line strong { font-weight: 700; color: #24422a; }

  .footer-bar {
    text-align: center;
    padding: 2rem 1.25rem 2.6rem;
    background: #93ab82;
  }
  .footer-top {
    display: inline-flex;
    align-items: center; justify-content: center;
    width: 42px; height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    color: #fff;
    margin-bottom: 1rem;
    transition: transform 0.3s var(--spring), background 0.3s ease;
  }
  .footer-top:hover { transform: translateY(-3px); background: rgba(255,255,255,0.5); }
  .footer-name {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: 4px;
  }
  .footer-role {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0.9rem;
  }
  .footer-legal { font-size: 0.75rem; color: rgba(255, 255, 255, 0.85); }
  .footer-legal a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
  .footer-credit { margin-top: 0.6rem; font-size: 0.68rem; color: rgba(255, 255, 255, 0.6); }
  .footer-credit a { color: inherit; text-decoration: none; }
</style>
