---
import Mascot from './Mascot.astro';
import Scribble from './Scribble.astro';

const consultations = [
  { label: "Premier entretien d'anamnèse", meta: '1 heure',    price: '60 €' },
  { label: 'Séance de consultation / suivi', meta: '45 minutes', price: '45 €' },
  { label: 'Séance de suivi — enfant de moins de 9 ans', meta: '30 minutes', price: '35 €' },
  { label: 'Séance de guidance parentale', meta: '1 heure',     price: '60 €' },
];

const bilans = [
  { price: '280 €', label: 'Intellectuel', tests: 'WISC-V ou WPPSI-IV' },
  { price: '320 €', label: 'Intellectuel + questionnaire', tests: 'WISC-V ou WPPSI-IV' },
  { price: '350 €', label: 'Intellectuel + attentionnel & fonctions exécutives + questionnaire', tests: 'WISC-V + TEA-Ch' },
  { price: '380 €', label: 'Fonctionnement autistique & perception sociale', tests: 'ADI-R + Mepsy ou PEP-3' },
  { price: '430 €', label: 'Évaluation globale : intellectuel + attentionnel & fonctions exécutives + fonctionnement autistique & perception sociale', tests: 'WISC-V + TEA-Ch + Mepsy II + ADI-R' },
];
---
<section id="tarification" class="section tarification">
  <div class="tarif-mascot"><Mascot size={64} /></div>

  <div class="section-inner">

    <h2 class="sec-title tarif-title reveal">Consultation &amp; Tarification</h2>
    <div class="tarif-scribble reveal"><Scribble variant="swoosh" width={150} /></div>

    <!-- Consultations -->
    <div class="tarif-card reveal">
      <ul class="tarif-list">
        {consultations.map(c => (
          <li class="tarif-row">
            <span class="tarif-row-label">
              {c.label}
              <span class="tarif-row-meta">{c.meta}</span>
            </span>
            <span class="tarif-price">{c.price}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Bilans neuropsy -->
    <h3 class="tarif-sub reveal">Bilan neuropsychologique</h3>
    <p class="tarif-sub-lead reveal">
      Séances d'anamnèse, puis évaluation, cotation, rédaction et restitution&nbsp;:
    </p>

    <div class="tarif-card reveal">
      <ul class="tarif-list">
        {bilans.map(b => (
          <li class="tarif-row tarif-row--bilan">
            <span class="tarif-price tarif-price--lead">{b.price}</span>
            <span class="tarif-row-label">
              {b.label}
              <span class="tarif-row-meta">{b.tests}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Notes -->
    <div class="tarif-notes reveal">
      <p>
        Possibilité d'évaluer l'anxiété et les aptitudes sociales par questionnaire, ainsi que
        le développement adaptatif <span class="tarif-tests">(Vineland, R-CMAS, SSIS-SEL)</span>.
      </p>
      <p>
        Je suis conventionnée par la <strong>PRE de Miramas</strong>, la <strong>PCO 0-6 ans</strong>,
        la <strong>PCO 7-12 ans</strong> et le <strong>parcours COCON</strong>.
      </p>
      <p class="tarif-pay">💳 Paiement en espèces ou par chèque.</p>
    </div>

  </div>
</section>

<style>
  .tarification { background: #93ab82; color: #26301f; }
  .tarif-title { color: #223018; }
  .tarif-scribble { display: flex; justify-content: center; margin: 0.3rem 0 2.4rem; line-height: 0; }
  .tarif-scribble :global(.scribble path) { stroke: #223018; }

  .tarif-card {
    background: rgba(255, 255, 255, 0.92);
    border-radius: 22px;
    padding: 0.6rem 1.4rem;
    box-shadow: 0 14px 34px rgba(45, 60, 35, 0.18);
    max-width: 720px;
    margin: 0 auto;
  }

  .tarif-list { list-style: none; }
  .tarif-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.4rem;
    border-bottom: 1px solid rgba(147, 171, 130, 0.25);
  }
  .tarif-row:last-child { border-bottom: none; }
  .tarif-row--bilan { align-items: flex-start; }

  .tarif-row-label {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.92rem;
    font-weight: 500;
    color: #33402b;
    line-height: 1.45;
  }
  .tarif-row-meta {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: 0.76rem;
    color: #8a9880;
  }

  .tarif-price {
    flex-shrink: 0;
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    background: #93ab82;
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    box-shadow: 0 4px 12px rgba(127, 154, 111, 0.4);
    white-space: nowrap;
  }
  .tarif-price--lead {
    background: #e087a0;
    box-shadow: 0 4px 12px rgba(224, 135, 160, 0.4);
    min-width: 4.2rem;
    text-align: center;
  }

  .tarif-sub {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: #223018;
    text-align: center;
    margin: 2.6rem 0 0.4rem;
  }
  .tarif-sub-lead {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.88rem;
    color: #33402b;
    text-align: center;
    margin-bottom: 1.4rem;
  }

  .tarif-notes {
    max-width: 700px;
    margin: 2.2rem auto 0;
    text-align: center;
  }
  .tarif-notes p {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.86rem;
    line-height: 1.7;
    color: #2c3823;
    margin-bottom: 0.9rem;
  }
  .tarif-notes strong { font-weight: 600; color: #1f2b16; }
  .tarif-tests { font-style: italic; color: #46523a; }
  .tarif-pay {
    display: inline-block;
    background: rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    font-weight: 500 !important;
    margin-top: 0.4rem;
  }

  .tarif-mascot { position: absolute; top: 6%; left: 6%; line-height: 0; opacity: 0.95; }
  @media (max-width: 760px) {
    .tarif-mascot { display: none; }
    .tarif-price--lead { min-width: 3.6rem; }
  }
</style>
