---
import Mascot from './Mascot.astro';
import SectionHeading from './SectionHeading.astro';
import Divider from './Divider.astro';

const consultations = [
  { label: "Premier entretien d'anamnèse", meta: '1 heure',    price: '60 €' },
  { label: 'Séance de consultation / suivi', meta: '45 minutes', price: '45 €' },
  { label: 'Séance de suivi — enfant de moins de 9 ans', meta: '30 minutes', price: '35 €' },
  { label: 'Séance de guidance parentale', meta: '1 heure',     price: '60 €' },
];
const bilans = [
  { price: '280 €', label: 'Intellectuel', tests: 'WISC-V ou WPPSI-IV', top: false },
  { price: '320 €', label: 'Intellectuel + questionnaire', tests: 'WISC-V ou WPPSI-IV', top: false },
  { price: '350 €', label: 'Intellectuel + attentionnel & fonctions exécutives + questionnaire', tests: 'WISC-V + TEA-Ch', top: false },
  { price: '380 €', label: 'Fonctionnement autistique & perception sociale', tests: 'ADI-R + Mepsy ou PEP-3', top: false },
  { price: '430 €', label: 'Évaluation globale — intellectuel, attentionnel, fonctions exécutives & fonctionnement autistique', tests: 'WISC-V + TEA-Ch + Mepsy II + ADI-R', top: true },
];
---
<section id="tarification" class="section tarification">
  <span class="blob tar-blob-1" aria-hidden="true"></span>
  <span class="blob tar-blob-2" aria-hidden="true"></span>
  <div class="tar-mascot" data-parallax="0.1"><Mascot size={60} /></div>

  <div class="section-inner">
    <SectionHeading eyebrow="Tarifs" light>
      Consultations &amp; <span class="mark">bilans</span>
      <Fragment slot="lead">Des tarifs clairs, adaptés à chaque situation.</Fragment>
    </SectionHeading>

    <div class="tar-grid">

      <!-- Consultations -->
      <div class="tar-card card reveal reveal-left">
        <div class="tar-card-head">
          <span class="badge tar-badge-green">Consultations</span>
        </div>
        <ul class="tar-list" data-stagger="70">
          {consultations.map(c => (
            <li class="tar-row">
              <span class="tar-row-label">{c.label}<span class="tar-row-meta">{c.meta}</span></span>
              <span class="tar-price tar-price-green">{c.price}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bilans -->
      <div class="tar-card card reveal reveal-right">
        <div class="tar-card-head">
          <span class="badge tar-badge-pink">Bilans neuropsychologiques</span>
          <p class="tar-card-sub">Anamnèse, évaluation, cotation, rédaction &amp; restitution</p>
        </div>
        <ul class="tar-list" data-stagger="70">
          {bilans.map(b => (
            <li class:list={['tar-row', 'tar-row--bilan', { 'tar-row--top': b.top }]}>
              <span class="tar-price tar-price-pink">{b.price}</span>
              <span class="tar-row-label">
                {b.top && <span class="tar-top-tag">Le plus complet</span>}
                {b.label}<span class="tar-row-meta">{b.tests}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Infos -->
    <div class="tar-info reveal">
      <div class="tar-info-item">
        <span class="tar-info-icon">📋</span>
        Évaluation possible de l'anxiété, des aptitudes sociales et du développement adaptatif
        <em>(Vineland, R-CMAS, SSIS-SEL)</em>.
      </div>
      <div class="tar-info-item">
        <span class="tar-info-icon">🤝</span>
        Conventionnée&nbsp;: <strong>PRE de Miramas</strong>, <strong>PCO 0-6 ans</strong>,
        <strong>PCO 7-12 ans</strong>, <strong>parcours COCON</strong>.
      </div>
      <div class="tar-info-item">
        <span class="tar-info-icon">💳</span>
        Paiement en espèces ou par chèque.
      </div>
    </div>
  </div>

  <Divider color="#c6dbba" variant={2} />
</section>

<style>
  .tarification {
    background: linear-gradient(180deg, #93ab82 0%, #86a075 100%);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }
  .tar-blob-1 { width: 400px; height: 400px; top: -4%; left: -8%; background: radial-gradient(circle, rgba(255,255,255,0.28), transparent 70%); }
  .tar-blob-2 { width: 340px; height: 340px; bottom: 6%; right: -6%; background: radial-gradient(circle, rgba(240,163,184,0.22), transparent 70%); }
  .tar-mascot { position: absolute; top: 5%; left: 5%; z-index: 1; line-height: 0; }

  .tar-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
  @media (min-width: 880px) { .tar-grid { grid-template-columns: 1fr 1fr; } }

  .tar-card { padding: clamp(1.4rem, 3vw, 2rem); }
  .tar-card-head { margin-bottom: 0.4rem; }
  .tar-card-sub { font-family: 'Montserrat', sans-serif; font-size: 0.78rem; color: #7a8b70; margin-top: 0.6rem; }
  .tar-badge-green { background: rgba(147, 171, 130, 0.2); color: #4a5c41; }
  .tar-badge-pink { background: rgba(240, 163, 184, 0.22); color: #c06783; }

  .tar-list { list-style: none; }
  .tar-row {
    display: flex; align-items: center; gap: 1rem;
    padding: 0.95rem 0.6rem;
    border-bottom: 1px solid rgba(147, 171, 130, 0.2);
    border-radius: 10px;
    transition: background 0.3s ease;
  }
  .tar-row:last-child { border-bottom: none; }
  .tar-row:hover { background: rgba(168, 200, 147, 0.12); }
  .tar-row--bilan { align-items: flex-start; }
  .tar-row--top { background: linear-gradient(135deg, rgba(240,163,184,0.14), rgba(168,200,147,0.1)); border: 1px solid rgba(240,163,184,0.3); margin-top: 0.4rem; }

  .tar-row-label {
    flex: 1; display: flex; flex-direction: column; gap: 0.2rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.9rem; font-weight: 500;
    color: #33402b; line-height: 1.45;
  }
  .tar-row-meta { font-family: 'Montserrat', sans-serif; font-weight: 400; font-size: 0.75rem; color: #8a9880; }
  .tar-top-tag {
    align-self: flex-start;
    font-family: 'Quicksand', sans-serif; font-weight: 700; font-size: 0.6rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: #fff;
    background: linear-gradient(135deg, #f0a3b8, #e087a0);
    padding: 2px 8px; border-radius: 999px; margin-bottom: 0.15rem;
  }

  .tar-price {
    flex-shrink: 0;
    font-family: 'Quicksand', sans-serif; font-weight: 700; font-size: 1rem;
    color: #fff; border-radius: 999px; padding: 0.4rem 0.95rem; white-space: nowrap;
  }
  .tar-price-green { background: linear-gradient(135deg, #a9c69c, #7f9a6f); box-shadow: 0 6px 14px -6px rgba(127,154,111,0.6); }
  .tar-price-pink { background: linear-gradient(135deg, #f0a3b8, #e087a0); box-shadow: 0 6px 14px -6px rgba(224,135,160,0.6); min-width: 4.3rem; text-align: center; }

  /* Infos */
  .tar-info {
    margin-top: 1.6rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-radius: 20px;
    padding: 1.4rem 1.6rem;
    display: flex; flex-direction: column; gap: 0.85rem;
  }
  .tar-info-item {
    display: flex; align-items: flex-start; gap: 0.7rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.86rem; line-height: 1.5; color: #34402c;
  }
  .tar-info-icon { flex-shrink: 0; font-size: 1.05rem; line-height: 1.3; }
  .tar-info-item strong { font-weight: 600; color: #2f5a3a; }
  .tar-info-item em { font-style: italic; color: #62735a; }
</style>
