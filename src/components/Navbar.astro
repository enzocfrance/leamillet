---
interface Props {
  isHome?: boolean;
}
const { isHome = true } = Astro.props;

const navItems = [
  { id: 'accueil',      label: 'Accueil' },
  { id: 'presentation', label: 'Présentation' },
  { id: 'cabinet',      label: 'Cabinet' },
  { id: 'pratique',     label: 'Le suivi' },
  { id: 'tarification', label: 'Tarifs' },
  { id: 'contact',      label: 'Contact' },
];
---
<header id="nav" class:list={['nav', { 'nav--sub': !isHome }]}>
  <div class="nav-inner">

    <a href={isHome ? '#accueil' : '/'} class="nav-brand" aria-label="Millet Léa — Accueil">
      <img src="/pictures/logo.png" alt="Logo Millet Léa" />
      <span class="nav-brand-name">Millet&nbsp;Léa</span>
    </a>

    {isHome ? (
      <>
        <nav class="nav-links" aria-label="Navigation principale">
          {navItems.map(item => (
            <a href={`#${item.id}`} class="nav-link" data-section={item.id}>{item.label}</a>
          ))}
        </nav>

        <a href="#contact" class="nav-cta">Prendre RDV</a>

        <button id="nav-burger" class="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </>
    ) : (
      <a href="/" class="nav-cta">← Retour au site</a>
    )}
  </div>

  {isHome && (
    <div id="nav-mobile" class="nav-mobile" aria-hidden="true">
      {navItems.map(item => (
        <a href={`#${item.id}`} class="nav-mobile-link" data-section={item.id}>{item.label}</a>
      ))}
      <a href="#contact" class="nav-mobile-cta">Prendre rendez-vous</a>
    </div>
  )}
</header>

<style is:global>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(215, 230, 204, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(147, 171, 130, 0.25);
  }
  .nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 62px;
    padding: 0 1.1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; flex-shrink: 0; }
  .nav-brand img {
    width: 38px; height: 38px;
    border-radius: 50%;
    object-fit: contain;
    background: #fff;
    padding: 4px;
    box-shadow: 0 3px 12px rgba(60, 80, 55, 0.18);
  }
  .nav-brand-name {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    color: #2b342d;
  }

  .nav-links { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; }
  .nav-link {
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: #46523f;
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .nav-link:hover { background: rgba(255,255,255,0.55); color: #2b342d; }
  .nav-link.active { background: #93ab82; color: #fff; }

  .nav-cta {
    flex-shrink: 0;
    font-family: 'Quicksand', sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    color: #fff;
    background: #e087a0;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 6px 16px rgba(224, 135, 160, 0.35);
    transition: transform 0.3s var(--spring), box-shadow 0.3s ease, background 0.3s ease;
  }
  .nav--sub .nav-cta { background: #93ab82; box-shadow: 0 6px 16px rgba(127,154,111,0.35); }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(224, 135, 160, 0.5); }

  /* Burger */
  .nav-burger {
    display: none;
    margin-left: auto;
    width: 40px; height: 40px;
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    background: #fff;
    border: none;
    border-radius: 50%;
    box-shadow: 0 3px 12px rgba(60, 80, 55, 0.18);
    cursor: pointer;
  }
  .nav-burger span {
    display: block; width: 18px; height: 2px; border-radius: 2px;
    background: #46523f;
    transition: transform 0.35s var(--spring), opacity 0.2s ease;
  }
  .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Menu mobile */
  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 1.1rem 1rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.4s var(--expo-out), opacity 0.3s ease, padding 0.3s ease;
  }
  .nav-mobile.open { max-height: 460px; opacity: 1; }
  .nav-mobile-link {
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    font-size: 1rem;
    color: #46523f;
    text-decoration: none;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid rgba(147, 171, 130, 0.2);
  }
  .nav-mobile-link.active { color: #e087a0; }
  .nav-mobile-cta {
    margin-top: 0.6rem;
    text-align: center;
    font-family: 'Quicksand', sans-serif;
    font-weight: 600;
    color: #fff;
    background: #e087a0;
    padding: 0.7rem;
    border-radius: 999px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .nav-links, .nav-inner > .nav-cta { display: none; }
    .nav-burger { display: flex; }
  }
</style>

<script>
  (function () {
    const burger  = document.getElementById('nav-burger');
    const mobile  = document.getElementById('nav-mobile');
    const links   = document.querySelectorAll<HTMLElement>('.nav-link, .nav-mobile-link');
    const ids     = ['accueil','presentation','cabinet','pratique','tarification','contact'];

    /* Burger toggle */
    let open = false;
    function setMenu(v: boolean) {
      open = v;
      burger?.classList.toggle('open', v);
      mobile?.classList.toggle('open', v);
      mobile?.setAttribute('aria-hidden', String(!v));
      burger?.setAttribute('aria-expanded', String(v));
    }
    burger?.addEventListener('click', () => setMenu(!open));
    mobile?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setMenu(false)));

    /* Section active */
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const id = e.target.id;
            links.forEach(l => l.classList.toggle('active', l.dataset.section === id));
          }
        });
      }, { threshold: 0.25, rootMargin: '-62px 0px -45% 0px' });
      ids.forEach(id => { const el = document.getElementById(id); if (el) obs.observe(el); });
    }
  })();
</script>
