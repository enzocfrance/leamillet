---
const PHONE_DISPLAY = '+33 6 16 03 75 37';
const PHONE_HREF = 'tel:+33616037537';
const EMAIL = 'lea.millet.psy13@gmail.com';
const DOCTOLIB = 'https://www.doctolib.fr/psychologue/miramas/lea-millet/booking';
---
<section
  id="contact"
  class="relative pb-32 pt-20"
  style="background: radial-gradient(ellipse at 10% 90%, rgba(167,218,229,0.22) 0%, transparent 50%), radial-gradient(ellipse at 90% 10%, rgba(168,200,147,0.18) 0%, transparent 50%), linear-gradient(160deg, #0f8b8d 0%, #016d77 100%);"
>
  <div class="mx-auto max-w-4xl px-5 sm:px-10 md:px-20">

    <h2 class="scroll-zoom section-heading heading-light">ME CONTACTER</h2>

    <p class="slide-up mb-3 text-center italic text-white/85 font-lato">
      Prendre rendez-vous n'a jamais été aussi simple.
    </p>
    <p class="slide-up mb-10 text-center text-sm text-white/80 font-candal" style="letter-spacing:0.04em;">
      Ouverture le <span style="color:#a7dae5;">mercredi</span>, de 9&nbsp;h à 18&nbsp;h.
    </p>

    <!-- Cards de contact -->
    <div class="stagger grid grid-cols-1 gap-6 md:grid-cols-2">

      <!-- Téléphone -->
      <div class="contact-card slide-up flex flex-col items-center gap-5 rounded-3xl border border-white/25 bg-white/15 p-5 sm:p-8 text-center backdrop-blur-md">
        <div class="contact-icon-ring">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div>
          <p class="mb-1 text-[10px] tracking-widest text-white/60 uppercase">Téléphone</p>
          <a href={PHONE_HREF} class="contact-info-link" style="font-family:'Candal',sans-serif; font-size:1.1rem;">{PHONE_DISPLAY}</a>
        </div>
        <a href={PHONE_HREF} class="btn-primary mt-auto text-white shadow-md" style="background:#016d77;">
          Appeler le cabinet
        </a>
      </div>

      <!-- Email -->
      <div class="contact-card slide-up flex flex-col items-center gap-5 rounded-3xl border border-white/25 bg-white/15 p-5 sm:p-8 text-center backdrop-blur-md">
        <div class="contact-icon-ring">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <div>
          <p class="mb-1 text-[10px] tracking-widest text-white/60 uppercase">Email</p>
          <a
            href={`mailto:${EMAIL}`}
            class="contact-info-link"
            style="font-family:'Candal',sans-serif; font-size:0.82rem; display:inline-block; max-width:24ch; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:bottom;"
          >{EMAIL}</a>
        </div>
        <a href={`mailto:${EMAIL}`} class="btn-primary mt-auto text-white shadow-md" style="background:#016d77;">
          Envoyer un mail
        </a>
      </div>

    </div>

    <!-- Doctolib CTA -->
    <div class="slide-up mt-12 text-center">
      <p class="mb-4 text-sm text-white/80" style="font-family:'Candal',sans-serif;">ou directement en ligne&nbsp;:</p>
      <a
        href={DOCTOLIB}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary inline-flex items-center gap-2 bg-white/25 text-white backdrop-blur-sm hover:bg-white/40"
      >
        Prendre rendez-vous sur
        <img src="https://pro.doctolib.fr/external_button/doctolib-white-transparent.png" alt="Doctolib" class="block h-[18px] w-auto" />
      </a>
    </div>

  </div>

  <!-- Wave → footer (#016d77) -->
  <div class="wave-seal pointer-events-none absolute bottom-0 left-0 w-full" style="line-height:0; margin-bottom:-1px;" aria-hidden="true">
    <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width:100%; height:60px; display:block;">
      <path fill="#016d77" d="M0,40 C420,10 1020,60 1440,35 L1440,60 L0,60 Z"/>
    </svg>
  </div>
</section>

<style is:global>
  /* ── Icon ring + pulse animation ───────────────────────── */
  .contact-icon-ring {
    display: flex; align-items: center; justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    padding: 16px;
    animation: contact-ring-pulse 2.5s ease-in-out infinite;
  }
  @keyframes contact-ring-pulse {
    0%   { box-shadow: 0 0 0 0px rgba(255, 255, 255, 0.35); }
    50%  { box-shadow: 0 0 0 12px rgba(255, 255, 255, 0); }
    100% { box-shadow: 0 0 0 0px rgba(255, 255, 255, 0); }
  }

  /* ── Info links ─────────────────────────────────────────── */
  .contact-info-link {
    color: white;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s ease;
  }
  .contact-info-link:hover { border-color: white; }

  /* ── Card hover + shine sweep ───────────────────────────── */
  .contact-card {
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .contact-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    background: linear-gradient(115deg, transparent 0%, transparent 40%, rgba(255, 255, 255, 0.12) 50%, transparent 60%, transparent 100%);
    background-size: 200% 100%;
    background-position: -100% 0;
    transition: background-position 0.5s ease;
    pointer-events: none;
  }
  .contact-card:hover::after { background-position: 200% 0; }
  .contact-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }
</style>
