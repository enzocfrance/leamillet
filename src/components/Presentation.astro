---
const credentials = [
  { icon: '🎓', label: 'Master Autisme & Troubles Neurodéveloppementaux' },
  { icon: '🌱', label: "Formée à l'ESDM — Sessad Smile" },
  { icon: '🧩', label: 'Intervention précoce' },
  { icon: '🏫', label: 'Ancienne UEMA & hôpital de jour' },
];
---
<section
  id="presentation"
  class="relative overflow-hidden"
  style="background: linear-gradient(160deg, #82c5bd 0%, #6fb3ab 55%, #5fa89f 100%);"
>
  <div class="mx-auto w-full max-w-5xl px-5 sm:px-10">

    <h2 class="scroll-zoom section-heading heading-light">PRÉSENTATION</h2>

    <div class="pres-grid">

      <!-- ── Colonne médaillon + credentials ── -->
      <aside class="pres-aside slide-up">
        <div class="pres-medallion">
          <img src="/pictures/logo.png" alt="Léa Millet" />
        </div>
        <p class="pres-name">Léa Millet</p>
        <p class="pres-role">Psychologue Clinicienne D.E</p>

        <ul class="pres-creds">
          {credentials.map(c => (
            <li class="pres-cred">
              <span class="pres-cred-icon" aria-hidden="true">{c.icon}</span>
              <span>{c.label}</span>
            </li>
          ))}
        </ul>
      </aside>

      <!-- ── Colonne bio ── -->
      <div class="pres-bio slide-up">
        <span class="pres-quote" aria-hidden="true">“</span>

        <p>
          Je suis <strong>Léa Millet</strong>, psychologue clinicienne D.E spécialisée dans les
          troubles neurodéveloppementaux. J'ai choisi d'orienter mon cursus universitaire dans un
          master de psychologie clinique, psychopathologie de la santé, parcours
          <strong>autisme et autres troubles neurodéveloppementaux</strong>, fondé par le Docteur
          en psychologie Bernadette&nbsp;Rogé. Lors de ma formation, j'ai eu l'opportunité de me
          former durant un stage à <strong>l'ESDM</strong> au sein du Sessad&nbsp;Smile. Cette
          expérience m'a permis de développer ma pratique dans l'intervention précoce.
        </p>

        <p>
          Après deux années passées à exercer mon métier au sein d'un <strong>dispositif UEMA</strong>
          (unités d'enseignement maternelle pour les enfants autistes) et en hôpital de jour pour
          enfants — présentant des troubles neurodéveloppementaux, des troubles anxieux ou de
          l'attachement — j'installe aujourd'hui <strong>mon cabinet libéral</strong> dans la
          commune de Miramas.
        </p>
      </div>

    </div>
  </div>

  <!-- Wave → pratique (#eef8e6) -->
  <div class="wave-seal pointer-events-none absolute bottom-0 left-0 w-full" style="line-height:0; margin-bottom:-1px;" aria-hidden="true">
    <svg viewBox="0 0 1440 70" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width:100%; height:70px; display:block;">
      <path fill="rgba(213,241,209,0.5)" d="M0,35 C480,0 960,70 1440,35 L1440,70 L0,70 Z"/>
      <path fill="#eef8e6" d="M0,45 C420,10 1020,65 1440,45 L1440,70 L0,70 Z"/>
    </svg>
  </div>
</section>

<style is:global>
  .pres-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .pres-grid { grid-template-columns: 300px 1fr; gap: 3rem; }
  }

  /* ── Aside médaillon ── */
  .pres-aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 24px;
    padding: 2rem 1.5rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 12px 40px rgba(1, 74, 82, 0.15);
  }
  @media (min-width: 900px) {
    .pres-aside { position: sticky; top: 90px; }
  }

  .pres-medallion {
    width: 110px; height: 110px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 8px 26px rgba(1, 74, 82, 0.25);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    padding: 12px;
  }
  .pres-medallion img { width: 100%; height: 100%; object-fit: contain; }

  .pres-name {
    font-family: 'Candal', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    color: #ffffff;
    margin-top: 1.1rem;
  }
  .pres-role {
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.82);
    margin-top: 0.2rem;
    margin-bottom: 1.4rem;
  }

  .pres-creds {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: 100%;
    text-align: left;
  }
  .pres-cred {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: 'Lato', sans-serif;
    font-size: 0.82rem;
    line-height: 1.35;
    color: #21484a;
    background: rgba(255, 255, 255, 0.55);
    border-radius: 12px;
    padding: 0.55rem 0.8rem;
    transition: transform 0.3s var(--spring), background 0.3s ease;
  }
  .pres-cred:hover {
    transform: translateX(4px);
    background: rgba(255, 255, 255, 0.78);
  }
  .pres-cred-icon { font-size: 1.05rem; flex-shrink: 0; }

  /* ── Bio ── */
  .pres-bio {
    position: relative;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 24px;
    padding: 2.5rem 2.25rem;
    box-shadow: 0 16px 44px rgba(1, 74, 82, 0.18);
  }
  .pres-quote {
    position: absolute;
    top: -0.5rem; left: 1.2rem;
    font-family: Georgia, serif;
    font-size: 4.5rem;
    line-height: 1;
    color: rgba(1, 109, 119, 0.18);
    pointer-events: none;
  }
  .pres-bio p {
    font-family: 'Lato', sans-serif;
    font-size: 0.98rem;
    line-height: 1.9;
    color: #4a5c5b;
    margin-bottom: 1.2rem;
  }
  .pres-bio p:last-child { margin-bottom: 0; }
  .pres-bio strong { color: #016d77; font-weight: 700; }

  @media (max-width: 639px) {
    .pres-bio { padding: 2rem 1.4rem; }
    .pres-bio p { font-size: 0.92rem; line-height: 1.8; }
  }
</style>
