---
import Mascot from './Mascot.astro';
import Scribble from './Scribble.astro';
---
<section id="accueil" class="section hero">
  <!-- petits accents décoratifs -->
  <div class="hero-scribble hero-scribble-1"><Scribble variant="sparkle" width={54} /></div>
  <div class="hero-scribble hero-scribble-2"><Scribble variant="swoosh" width={120} /></div>

  <div class="section-inner hero-inner">

    <h1 class="hero-title reveal">Millet Léa</h1>

    <p class="hero-subtitle reveal reveal-delay-1">
      Psychologue clinicienne spécialisée dans l'autisme et les troubles
      du neurodéveloppement chez l'enfant — D.E
    </p>

    <div class="hero-mascot reveal reveal-delay-2">
      <Mascot size={150} />
    </div>

    <p class="hero-lead reveal reveal-delay-3">
      J'accompagne les enfants, adolescents et leurs familles dans la compréhension
      de leurs difficultés, le développement de leurs compétences, et leur
      épanouissement au quotidien.
    </p>

  </div>
</section>

<style>
  .hero {
    background: #d7e6cc;
    padding-top: calc(62px + clamp(2.5rem, 6vw, 4.5rem));
    text-align: center;
  }
  .hero-inner { max-width: 760px; }

  .hero-title {
    font-family: 'Quicksand', sans-serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 8vw, 4rem);
    letter-spacing: 0.02em;
    color: #2b342d;
    line-height: 1.05;
  }
  .hero-subtitle {
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    font-size: clamp(0.95rem, 2.4vw, 1.2rem);
    line-height: 1.6;
    color: #46523f;
    max-width: 560px;
    margin: 0.9rem auto 0;
  }
  .hero-mascot { margin: 2.2rem 0; }
  .hero-lead {
    font-family: 'Montserrat', sans-serif;
    font-weight: 400;
    font-size: clamp(0.92rem, 2vw, 1.05rem);
    line-height: 1.9;
    color: #37423a;
    max-width: 560px;
    margin: 0 auto;
  }

  /* accents dessinés */
  .hero-scribble { position: absolute; opacity: 0.8; line-height: 0; }
  .hero-scribble-1 { top: 120px; right: 14%; transform: rotate(6deg); }
  .hero-scribble-2 { bottom: 8%; left: 10%; transform: rotate(-4deg); }

  @media (max-width: 640px) {
    .hero-scribble-1 { right: 6%; top: 96px; }
    .hero-scribble-2 { left: 4%; }
  }
</style>
