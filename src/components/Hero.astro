---
import Mascot from './Mascot.astro';
import Scribble from './Scribble.astro';
import Divider from './Divider.astro';

const tags = ['Bilans neuropsychologiques', 'Suivi individuel', 'Guidance parentale', 'Intervention précoce'];
---
<section id="accueil" class="section hero">
  <!-- décor de fond -->
  <span class="blob hero-blob-1" aria-hidden="true"></span>
  <span class="blob hero-blob-2" aria-hidden="true"></span>
  <span class="blob hero-blob-3" aria-hidden="true"></span>
  <div class="dotgrid hero-dots" aria-hidden="true"></div>
  <div class="hero-scribble hero-scribble-1" data-parallax="0.08"><Scribble variant="sparkle" width={54} /></div>
  <div class="hero-scribble hero-scribble-2" data-parallax="-0.06"><Scribble variant="swoosh" width={120} /></div>

  <div class="section-inner hero-inner">

    <span class="badge hero-badge reveal">🧠 Psychologue clinicienne D.E · Miramas</span>

    <h1 class="hero-title reveal reveal-delay-1">Millet&nbsp;Léa</h1>

    <p class="hero-role reveal reveal-delay-1">
      Spécialisée dans <span class="mark">l'autisme</span> &amp; les troubles du
      neurodéveloppement chez l'enfant
    </p>

    <div class="hero-medallion reveal reveal-delay-2" data-parallax="0.09">
      <span class="hero-ring" aria-hidden="true"></span>
      <span class="hero-orbit hero-orbit-a" aria-hidden="true"></span>
      <span class="hero-orbit hero-orbit-b" aria-hidden="true"></span>
      <Mascot size={150} />
    </div>

    <p class="hero-lead reveal reveal-delay-2">
      J'accompagne les enfants, adolescents et leurs familles dans la compréhension
      de leurs difficultés, le développement de leurs compétences et leur épanouissement
      au quotidien.
    </p>

    <div class="hero-cta reveal reveal-delay-3">
      <a href="#contact" class="btn btn-pink">Prendre rendez-vous</a>
      <a href="#cabinet" class="btn btn-ghost">Découvrir le cabinet</a>
    </div>

    <div class="hero-tags reveal reveal-delay-3">
      {tags.map(t => <span class="hero-tag">{t}</span>)}
    </div>

  </div>

  <a href="#presentation" class="hero-cue" aria-label="Défiler vers la présentation">
    <span>défiler</span>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </a>

  <Divider color="#a9c69c" variant={1} />
</section>

<style>
  .hero {
    background:
      radial-gradient(120% 90% at 50% -10%, #e4efdb 0%, transparent 55%),
      linear-gradient(180deg, #dcead1 0%, #cfe1c3 100%);
    padding-top: calc(62px + clamp(2rem, 5vw, 3.5rem));
    padding-bottom: clamp(5rem, 10vw, 8rem);
    text-align: center;
    min-height: var(--hero-mh, 100svh);
    display: flex;
    align-items: center;
  }
  .hero-inner { max-width: 720px; display: flex; flex-direction: column; align-items: center; }

  /* décor */
  .hero-blob-1 { width: 460px; height: 460px; top: -8%; right: -6%; background: radial-gradient(circle, rgba(240,163,184,0.35), transparent 68%); }
  .hero-blob-2 { width: 420px; height: 420px; bottom: -6%; left: -8%; background: radial-gradient(circle, rgba(127,154,111,0.4), transparent 70%); }
  .hero-blob-3 { width: 320px; height: 320px; top: 34%; left: 40%; background: radial-gradient(circle, rgba(167,218,229,0.28), transparent 70%); }
  .hero-dots { width: 150px; height: 150px; top: 22%; left: 6%; }
  .hero-scribble { position: absolute; z-index: 1; line-height: 0; opacity: 0.8; }
  .hero-scribble-1 { top: 120px; right: 12%; transform: rotate(6deg); }
  .hero-scribble-2 { bottom: 12%; left: 9%; transform: rotate(-4deg); }

  .hero-badge {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(147, 171, 130, 0.35);
    color: #4a5c41;
    box-shadow: 0 6px 16px -8px rgba(60, 80, 55, 0.35);
    margin-bottom: 1.4rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 9vw, 4.4rem);
    letter-spacing: -0.01em;
    color: #263021;
    line-height: 1;
  }
  .hero-role {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1rem, 2.6vw, 1.3rem);
    line-height: 1.5;
    color: #46523f;
    max-width: 540px;
    margin: 0.9rem auto 0;
  }

  /* médaillon mascotte */
  .hero-medallion { position: relative; margin: 2.4rem 0; width: 180px; height: 180px; display: grid; place-items: center; }
  .hero-ring {
    position: absolute; inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0) 62%);
    box-shadow: 0 20px 50px -18px rgba(224, 135, 160, 0.5);
  }
  .hero-ring::before {
    content: '';
    position: absolute; inset: 8px;
    border-radius: 50%;
    border: 2px dashed rgba(147, 171, 130, 0.55);
    animation: hero-spin 26s linear infinite;
  }
  @keyframes hero-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hero-ring::before { animation: none; } }
  .hero-orbit { position: absolute; border-radius: 50%; }
  .hero-orbit-a { width: 14px; height: 14px; background: #e087a0; top: 6px; right: 26px; box-shadow: 0 4px 10px rgba(224,135,160,0.5); }
  .hero-orbit-b { width: 10px; height: 10px; background: #93ab82; bottom: 14px; left: 18px; box-shadow: 0 4px 10px rgba(127,154,111,0.5); }

  .hero-lead {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(0.92rem, 2vw, 1.05rem);
    line-height: 1.9;
    color: #3d4a3a;
    max-width: 560px;
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 1.9rem; }

  .hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 1.8rem; }
  .hero-tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #4a5c41;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(147, 171, 130, 0.3);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
  }

  .hero-cue {
    position: absolute;
    bottom: clamp(1.5rem, 4vw, 2.6rem); left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    color: rgba(70, 82, 63, 0.6);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 10px; letter-spacing: 0.18em; text-transform: lowercase;
    animation: hero-bob 1.8s ease-in-out infinite;
  }
  @keyframes hero-bob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .hero-cue { animation: none; } }

  @media (max-width: 640px) {
    .hero-scribble-1 { right: 5%; top: 100px; }
    .hero-scribble-2 { left: 4%; }
    .hero-cue { display: none; }
  }
</style>
