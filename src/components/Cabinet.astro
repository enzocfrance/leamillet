---
import Scribble from './Scribble.astro';

const photos = [
  { src: '/pictures/left.png',   alt: 'Le cabinet — espace de médiation thérapeutique' },
  { src: '/pictures/center.png', alt: 'Le cabinet — salle de consultation' },
  { src: '/pictures/right.png',  alt: 'Le cabinet — coin dédié aux enfants' },
];
---
<section id="cabinet" class="section cabinet">
  <div class="section-inner">

    <p class="cabinet-invite reveal">
      Afin de vous familiariser avec les lieux avant notre rendez-vous, je vous invite à
      découvrir quelques photos du cabinet.
    </p>
    <div class="cabinet-scribble reveal reveal-delay-1">
      <Scribble variant="underline" width={150} stroke="#2b342d" />
    </div>

    <div class="cabinet-gallery" data-stagger="140">
      {photos.map((p) => (
        <figure class="cabinet-photo reveal-scale">
          <img src={p.src} alt={p.alt} loading="lazy" />
        </figure>
      ))}
    </div>

  </div>
</section>

<style>
  .cabinet { background: #c6dbba; }

  .cabinet-invite {
    font-family: 'Quicksand', sans-serif;
    font-weight: 500;
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    line-height: 1.7;
    color: #2b342d;
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .cabinet-scribble { display: flex; justify-content: center; margin: 0.4rem 0 2.6rem; }

  .cabinet-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 720px) {
    .cabinet-gallery { grid-template-columns: repeat(3, 1fr); }
  }

  .cabinet-photo {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    background: #fff;
    padding: 5px;
    box-shadow: 0 14px 32px rgba(60, 80, 55, 0.16);
    transition: transform 0.4s var(--spring), box-shadow 0.4s ease;
  }
  .cabinet-photo:hover {
    transform: translateY(-5px);
    box-shadow: 0 22px 44px rgba(60, 80, 55, 0.24);
  }
  .cabinet-photo img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: 14px;
  }
  @media (max-width: 639px) {
    .cabinet-photo img { height: 210px; }
  }
</style>
