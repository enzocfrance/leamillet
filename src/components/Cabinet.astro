---
import SectionHeading from './SectionHeading.astro';
import Divider from './Divider.astro';

const photos = [
  { src: '/pictures/left.png',   alt: 'Espace de consultation du cabinet', caption: 'Espace de consultation' },
  { src: '/pictures/center.png', alt: 'Espace de médiation thérapeutique', caption: 'Espace de médiation' },
  { src: '/pictures/right.png',  alt: 'Matériel et jeux du cabinet',       caption: 'Matériel & jeux' },
];
---
<section id="cabinet" class="section cabinet">
  <span class="blob cab-blob-1" aria-hidden="true"></span>
  <span class="blob cab-blob-2" aria-hidden="true"></span>

  <div class="section-inner">
    <SectionHeading eyebrow="Le cabinet">
      Découvrir <span class="mark">les lieux</span>
      <Fragment slot="lead">
        Afin de vous familiariser avec le cabinet avant notre rendez-vous, je vous invite à en
        découvrir quelques photos — un espace pensé pour mettre l'enfant à l'aise.
      </Fragment>
    </SectionHeading>

    <div class="cab-gallery" data-stagger="140">
      {photos.map(p => (
        <figure class="cab-photo reveal-scale">
          <div class="cab-photo-img">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <Divider color="#a9c69c" variant={3} />
</section>

<style>
  .cabinet {
    background: linear-gradient(180deg, #c6dbba 0%, #d5e6ca 55%, #cfe1c3 100%);
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }
  .cab-blob-1 { width: 360px; height: 360px; top: 6%; right: -7%; background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%); }
  .cab-blob-2 { width: 320px; height: 320px; bottom: 8%; left: -7%; background: radial-gradient(circle, rgba(168,200,147,0.4), transparent 70%); }

  .cab-gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  @media (min-width: 720px) { .cab-gallery { grid-template-columns: repeat(3, 1fr); } }

  .cab-photo {
    margin: 0;
    background: #fbfdf7;
    border-radius: 20px;
    padding: 8px 8px 0;
    box-shadow: 0 22px 44px -24px rgba(47, 74, 44, 0.45);
    transition: transform 0.45s var(--spring), box-shadow 0.45s ease;
  }
  .cab-photo:hover {
    transform: translateY(-6px);
    box-shadow: 0 34px 60px -26px rgba(47, 74, 44, 0.55);
  }
  .cab-photo-img { border-radius: 14px; overflow: hidden; }
  .cab-photo img {
    display: block; width: 100%; height: 230px; object-fit: cover;
    transition: transform 0.6s var(--expo-out);
  }
  .cab-photo:hover img { transform: scale(1.06); }
  .cab-photo figcaption {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.82rem;
    color: #4a5c41;
    text-align: center;
    padding: 0.8rem 0.5rem 0.9rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 639px) { .cab-photo img { height: 210px; } }
</style>
